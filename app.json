{
  "expo": {
    "name": "Daily Poultry",
    "slug": "poultry-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#166534",
    "primaryColor": "#166534",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#166534"
    },
    "ios": {
      "supportsTablet": true,
      "backgroundColor": "#166534",
      "splash": {
        "image": "./assets/logo.png",
        "resizeMode": "contain",
        "backgroundColor": "#166534"
      }
    },
    "android": {
      "package": "com.broilix.app",
      "backgroundColor": "#166534",
      "adaptiveIcon": {
        "backgroundColor": "#166534",
        "foregroundImage": "./assets/logo.png"
      },
      "splash": {
        "image": "./assets/logo.png",
        "resizeMode": "contain",
        "backgroundColor": "#166534"
      },
      "predictiveBackGestureEnabled": false
    },
    "androidStatusBar": {
      "backgroundColor": "#166534",
      "barStyle": "light-content",
      "translucent": false
    },
    "androidNavigationBar": {
      "backgroundColor": "#166534",
      "barStyle": "light-content"
    },
    "web": {
      "favicon": "./assets/logo.png"
    },
    "plugins": [
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#166534",
          "image": "./assets/logo.png",
          "dark": {
            "backgroundColor": "#166534",
            "image": "./assets/logo.png"
          },
          "imageWidth": 260
        }
      ]
    ]
  }
}
